#---- Owner--------
environment = "dev"
owner = "kb-support.dsl@unibe.ch"

#------- Global --------

subscription_id         = "your-azure-subscription_id"
resource_group_name     = "rg-db-dev-001"
resource_group_location = "Switzerland North"

# ----- Cognitive Model --------
# chat deployment
cognitive_model_account_name        = "ao-db-dev-001"
cognitive_model_account_sku_name    = "S0"
cognitive_model_deployment_capacity = 500 #500,000 tokens per minute 
cognitive_model_deployment_sku_name = "GlobalStandard"
cognitive_model_deployment_name     = "gpt-5.2"
cognitive_model_name                = "gpt-5.2"
cognitive_model_version             = "2025-12-11"
cognitive_model_account_kind        = "OpenAI"
# embedding deployment
cognitive_model_embedding_deployment_capacity = 1000 #1,000,000 tokens per minute 
cognitive_model_embedding_deployment_name     = "text-embedding-3-large"
cognitive_model_embedding_name                = "text-embedding-3-large"
cognitive_model_embedding_version             = "1"
cognitive_model_embedding_deployment_sku_name = "GlobalStandard"

# ----- Container Registry reference (global) --------
container_registry_name = "crdbglobal001"
# if ACR is in global RG different from dev RG, set override:
container_registry_resource_group_name = "rg-db-global-001"
container_repository_name = "dsl-bot-backend-api"

# ----- Reference global Storage --------
storage_account_name = "sadbglobal001"
storage_account_resource_group_name = "rg-db-global-001"

# ----- Search Service --------
search_service_name = "ss-db-dev-001"
search_service_sku = "basic"
search_service_replica_count = 1
search_service_partition_count = 1
search_index_name = "index-bnf"


# ----- AKS cluster -----
aks_cluster_name     = "aks-db-dev-001"
aks_dns_prefix       = "kbdev"
aks_admin_username   = "azureuser"
aks_admin_ssh_public_keys = [
  "ssh-rsa-your-public-key"
]
aks_node_pool_name   = "systempool"
aks_node_count       = 1
aks_node_vm_size     = "Standard_B4ls_v2"
aks_node_os_disk_size_gb = 128
aks_node_os_sku      = "Ubuntu"
aks_node_resource_group_name = "rg-db-dev-001-node"

# ----- AKS user node pools -----
aks_additional_node_pools = {
  userpool1 = {
    vm_size              = "Standard_B4ls_v2"
    node_count           = 1
    os_disk_size_gb      = 128
    os_sku               = "Ubuntu"
    mode                 = "User"
    auto_scaling_enabled = true
    min_count            = 1
    max_count            = 2
  }
}

# ---- AKS Network (BYO to satisfy NSG UniBe policy) ----
# BYO to comply with UniBe Cloud policy to allows inbound TCP from anywhere to any node in the AKS subnet on Kubernetes' default NodePort range (30000–32767)
aks_vnet_name                 = "vnet-aks-db-dev-001"
aks_vnet_address_space        = ["10.40.0.0/16"]
aks_subnet_name               = "snet-aks-db-dev-001"
aks_subnet_address_prefix     = "10.40.1.0/24"
aks_network_security_group_name = "nsg-aks-db-dev-001"

# aks_api_destination_port = "*" # optional parameter to open port(s)

# ----- API Management (APIM) -----
# apim name must be globally unique in Azure
apim_name                 = "apim-db-dev-001"
apim_sku_name            = "Developer_1"
apim_publisher_name       = "Data Science Lab, University of Bern"
apim_publisher_email      = "kb-support.dsl@unibe.ch"


# API Configuration
# apim api name needs to be unique within a single APIM service instance.
apim_api_name             = "dsl-bot-api"
apim_api_display_name     = "DSL Bot API"
apim_api_path             = "api"
apim_api_revision         = "1"
apim_api_protocols        = ["https"]

apim_subscription_required = false


# CORS: allowed frontend origin — must be explicit (no wildcard) because cookies require credentials mode
apim_frontend_url = "http://localhost:5173"

# Rate limiting for /initialize-agent endpoint
apim_initialize_rate_limit_calls = 500    # 500 queries/ session creations per minute
apim_initialize_quota_calls      = 20000  # 20,000 sessions per day

# Rate limiting for /invoke-agent endpoint (STRICT - controls OpenAI costs)
apim_invoke_rate_limit_calls = 100    # 100 queries per minute (STRICT)
apim_invoke_quota_calls      = 5000  # 5,000 AI queries per day (STRICT)

# Rate limiting for /send-feedback endpoint
apim_feedback_rate_limit_calls = 200    # 200 feedback submissions per minute
apim_feedback_quota_calls      = 10000  # 10,000 feedback per day

# Note: /health endpoint has NO rate limits (for monitoring)

apim_backend_url          = "http://127.0.0.1:8000"