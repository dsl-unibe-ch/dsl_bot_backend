#---- Owner--------
environment = "prod"
owner = "support.dsl@unibe.ch"

#------- Global --------

subscription_id         = "your-azure-subscription_id"
resource_group_name     = "rg-kb-prod-001"
resource_group_location = "Switzerland North"

# ----- Cognitive Model --------
# chat deployment
cognitive_model_account_name        = "ao-kb-prod-001"
cognitive_model_account_sku_name    = "S0"
cognitive_model_deployment_sku_name = "GlobalStandard"
cognitive_model_deployment_capacity = 500 #500,000 tokens per minute 
cognitive_model_deployment_name     = "gpt-4.1"
cognitive_model_name                = "gpt-4.1"
cognitive_model_version             = "2025-04-14"
cognitive_model_account_kind        = "OpenAI"
# embedding deployment
cognitive_model_embedding_deployment_capacity = 1000 #1,000,000 tokens per minute 
cognitive_model_embedding_deployment_name     = "text-embedding-3-large"
cognitive_model_embedding_name                = "text-embedding-3-large"
cognitive_model_embedding_version             = "1"
cognitive_model_embedding_deployment_sku_name = "GlobalStandard"

# ----- Container Registry reference (global) --------
container_registry_name = "crkbglobal001"
# if ACR is in global RG different from prod RG, set override:
container_registry_resource_group_name = "rg-kb-global-001"
container_repository_name = "kioskbot-backend-api"

# ----- Reference global Storage --------
storage_account_name = "sakbglobal001"
storage_account_resource_group_name = "rg-kb-global-001"

# ----- Search Service --------
search_service_name = "ss-kb-prod-001"
search_service_sku = "basic"
search_service_replica_count = 1
search_service_partition_count = 1
search_index_name = "kb-quality-prod"


# ----- AKS cluster -----
aks_cluster_name     = "aks-kb-prod-001"
aks_dns_prefix       = "kbprod"
aks_admin_username   = "azureuser"
aks_admin_ssh_public_keys = [
  "ssh-rsa-your-public-key"
]
aks_node_pool_name   = "systempool"
aks_node_count       = 1
aks_node_vm_size     = "Standard_A2_v2"
aks_node_os_disk_size_gb = 128
aks_node_os_sku      = "Ubuntu"
aks_node_resource_group_name = "rg-kb-prod-001-node"

# ----- AKS user node pools -----
aks_additional_node_pools = {
  userpool1 = {
    vm_size              = "Standard_B4ls_v2"
    node_count           = 1
    os_disk_size_gb      = 128
    os_sku               = "Ubuntu"
    mode                 = "User"
    auto_scaling_enabled = true
    min_count            = 1
    max_count            = 2
  }
}

# ---- AKS Network (BYO to satisfy NSG UniBe policy) ----
# BYO to comply with UniBe Cloud policy to allows inbound TCP from anywhere to any node in the AKS subnet on Kubernetes' default NodePort range (30000–32767)
aks_vnet_name                 = "vnet-aks-kb-prod-001"
aks_vnet_address_space        = ["10.41.0.0/16"]
aks_subnet_name               = "snet-aks-kb-prod-001"
aks_subnet_address_prefix     = "10.41.1.0/24"
aks_network_security_group_name = "nsg-aks-kb-prod-001"

# aks_api_destination_port = "*" # optional parameter to open port(s)

# ----- API Management (APIM) -----
# Consumption tier: 1M requests/month FREE, then $0.035 per 10K calls
apim_name                 = "apim-kb-prod-001"
apim_sku_name            = "Developer_1"
apim_publisher_name       = "University of Bern"
apim_publisher_email      = "support.dsl@unibe.ch"
apim_backend_url          = "http://<AKS_CLUSTER_IP>:8000"

# API Configuration
apim_api_name             = "<your-api-name>"
apim_api_display_name     = "Your API Display Name"
apim_api_path             = "api"
apim_api_revision         = "1"
apim_api_protocols        = ["https"]

apim_subscription_required = false

# Rate limiting for /initialize-agent endpoint (higher limits)
apim_initialize_rate_limit_calls = 1000   # 1000 session creations per minute
apim_initialize_quota_calls      = 50000  # 50,000 sessions per day

# Rate limiting for /invoke-agent endpoint (STRICT - controls OpenAI costs)
apim_invoke_rate_limit_calls = 100   # 100 AI queries per minute (STRICT)
apim_invoke_quota_calls      = 10000 # 10,000 AI queries per day (STRICT)

# Rate limiting for /send-feedback endpoint (higher limits)
apim_feedback_rate_limit_calls = 500    # 500 feedback submissions per minute
apim_feedback_quota_calls      = 20000  # 20,000 feedback per day

